// ==UserScript==
// @name         Torn Revive Payment Tracker (Faction Shared)
// @namespace    https://torn.com/
// @version      3.6.4
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching.
// @author       You
// @match        https://www.torn.com/*
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @connect      api.torn.com
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function () {
    'use strict';

    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj-HsObFkWJZ1ch2Ydd5SR/exec";
    const STORAGE_KEY_APIKEY = 'trpt_api_keys';
    let sharedRevivesCache = [];
    let isFetchingRevives = false;
    let isInjecting = false;

    // Bulletproof CSS Injection for Torn React, TornTools, & Message Button Protection
    const badgeCSS = `
        .trpt-badge {
            font-size: 11px !important;
            padding: 2px 6px !important;
            margin-left: 6px !important;
            margin-right: 6px !important;
            border-radius: 3px !important;
            font-weight: bold !important;
            color: #ffffff !important;
            display: inline-block !important;
            vertical-align: middle !important;
            cursor: pointer !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.3) !important;
            z-index: 99999 !important;
            flex-shrink: 0 !important;
            white-space: nowrap !important;
            line-height: 1.2 !important;
        }
        .trpt-badge.paid { background-color: #28a745 !important; }
        .trpt-badge.unpaid { background-color: #dc3545 !important; }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(badgeCSS);
    } else {
        const style = document.createElement("style");
        style.textContent = badgeCSS;
        document.head.appendChild(style);
    }

    function getApiKey() {
        const raw = GM_getValue(STORAGE_KEY_APIKEY, '');
        if (!raw) return '';
        const keys = raw.split(',').map(k => k.trim()).filter(Boolean);
        if (keys.length === 0) return '';
        return keys[Math.floor(Math.random() * keys.length)];
    }

    function promptForApiKey() {
        const currentKeys = GM_getValue(STORAGE_KEY_APIKEY, '');
        const newKeys = prompt('[TRPT] Enter Torn API Key(s), separated by commas if using multiple:', currentKeys);
        if (newKeys !== null) {
            GM_setValue(STORAGE_KEY_APIKEY, newKeys.trim());
            alert('[TRPT] API Key(s) updated!');
            fetchPast24HourRevives();
        }
    }

    if (typeof GM_registerMenuCommand !== 'undefined') {
        GM_registerMenuCommand("Set/Update Torn API Key(s)", promptForApiKey);
    }

    function ensureApiKey() {
        let apiKey = getApiKey();
        if (!apiKey) promptForApiKey();
        return getApiKey();
    }

    function extractUserId(urlStr) {
        if (!urlStr) return null;
        const match = urlStr.match(/(?:XID|userID|NID|ID|step=profile&user=|user=|=)(\d+)/i);
        return match ? String(match[1]).trim() : null;
    }

    function isRevivePaid(revive) {
        if (!revive) return false;
        const val = revive.paid !== undefined ? revive.paid : revive.Paid;
        if (typeof val === 'boolean') return val;
        if (typeof val === 'number') return val === 1;
        if (typeof val === 'string') {
            const p = val.toUpperCase().trim();
            return p === 'TRUE' || p === '1' || p.includes('PAID');
        }
        return false;
    }

    // Cross-tab synchronized Google Sheets sync
    function syncGlobalData(callback) {
        if (!GOOGLE_SCRIPT_URL) return;

        const lastSync = GM_getValue('trpt_last_gsheet_sync', 0);
        if (Date.now() - lastSync < 25000) {
            const localCache = GM_getValue('trpt_shared_cache');
            if (localCache) sharedRevivesCache = JSON.parse(localCache);
            if (typeof callback === 'function') callback();
            return;
        }
        GM_setValue('trpt_last_gsheet_sync', Date.now());

        GM_xmlhttpRequest({
            method: 'GET',
            url: GOOGLE_SCRIPT_URL,
            anonymous: true,
            onload: function (response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (Array.isArray(data)) {
                        sharedRevivesCache = data;
                        GM_setValue('trpt_shared_cache', JSON.stringify(data));
                        console.log('[TRPT] Cache updated:', sharedRevivesCache.length, 'records.');
                        injectReputationBadges();
                        if (typeof callback === 'function') callback();
                    }
                } catch (e) {
                    console.error('[TRPT] Sync Error:', e);
                }
            }
        });
    }

    function logReviveToSheet(reviveData, callback) {
        if (!GOOGLE_SCRIPT_URL) return;
        GM_xmlhttpRequest({
            method: 'POST',
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/json" },
            data: JSON.stringify(reviveData),
            onload: function() {
                setTimeout(() => {
                    syncGlobalData(callback);
                }, 1000);
            }
        });
    }

    // Cross-tab synchronized Torn API fetch to avoid multi-tab rate limits
    function fetchPast24HourRevives() {
        if (isFetchingRevives) return;

        const lastFetch = GM_getValue('trpt_last_torn_fetch', 0);
        if (Date.now() - lastFetch < 55000) return; 
        GM_setValue('trpt_last_torn_fetch', Date.now());

        const apiKey = getApiKey();
        if (!apiKey) return;

        isFetchingRevives = true;
        const twentyFourHoursAgo = Math.floor((Date.now() - (24 * 60 * 60 * 1000)) / 1000);
        const apiUrl = `https://api.torn.com/faction/?selections=revives&from=${twentyFourHoursAgo}&key=${apiKey}`;

        GM_xmlhttpRequest({
            method: 'GET',
            url: apiUrl,
            onload: function(response) {
                isFetchingRevives = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data.error || !data.revives) return;

                    Object.keys(data.revives).forEach(reviveId => {
                        const r = data.revives[reviveId];
                        const existing = sharedRevivesCache.find(
                            cached => String(cached.reviveId || cached.revive_id || '').trim() === String(reviveId).trim()
                        );

                        if (!existing) {
                            logReviveToSheet({
                                timestamp: new Date((r.timestamp || Math.floor(Date.now() / 1000)) * 1000).toISOString(),
                                reviveId: String(reviveId),
                                reviverName: r.reviver_name || r.reviver_username || 'Unknown',
                                targetId: String(r.target_id || r.target_userID || r.target_user_id || ''),
                                targetName: r.target_name || r.target_username || 'Unknown',
                                paid: isRevivePaid(r)
                            });
                        }
                    });
                } catch (e) {
                    console.error('[TRPT] Revive Parse Error:', e);
                }
            },
            onerror: function() { isFetchingRevives = false; }
        });
    }

    function togglePaymentStatus(targetId) {
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === String(targetId).trim());
        let latest = history[history.length - 1];

        let newPaidStatus = latest ? !isRevivePaid(latest) : true;

        if (latest) {
            latest.paid = newPaidStatus;
            injectReputationBadges();
        }

        logReviveToSheet({
            timestamp: latest?.timestamp || new Date().toISOString(),
            reviveId: String(latest?.reviveId || `manual_${Date.now()}`),
            reviverName: latest?.reviverName || 'You',
            targetId: String(targetId),
            targetName: latest?.targetName || 'Manual Entry',
            paid: newPaidStatus
        });
    }

    function createBadgeElement(isPaid, targetId) {
        const badge = document.createElement('span');
        badge.className = `trpt-badge ${isPaid ? 'paid' : 'unpaid'}`;
        badge.textContent = isPaid ? 'PAID' : 'UNPAID';
        badge.title = 'Click to toggle status';

        badge.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (targetId) togglePaymentStatus(targetId);
        });

        return badge;
    }

    function applyBadgeToElement(targetContainer, targetId) {
        if (!targetContainer || !targetId) return;

        // Skip containers that host quick action buttons (Message, Trade, Attack) to prevent overlap bugs under TornTools
        if (targetContainer.querySelector('a[href*="send_message"], a[href*="trade.php"], a[href*="attacks.php"]') ||
            targetContainer.closest('.user-actions, .profile-buttons, [class*="actions"]')) {
            return;
        }

        const normalizedTargetId = String(targetId).trim();
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === normalizedTargetId);
        const existingBadge = targetContainer.querySelector('.trpt-badge');

        if (history.length > 0) {
            const isPaid = history.some(r => isRevivePaid(r));
            const expectedClass = isPaid ? 'trpt-badge paid' : 'trpt-badge unpaid';
            const expectedText = isPaid ? 'PAID' : 'UNPAID';

            if (existingBadge) {
                if (existingBadge.className !== expectedClass) {
                    existingBadge.className = expectedClass;
                    existingBadge.textContent = expectedText;
                }
            } else {
                const newBadge = createBadgeElement(isPaid, normalizedTargetId);
                const nameNode = targetContainer.querySelector('[class*="name"], .user-name, h4, .title') || targetContainer.firstChild;
                
                if (nameNode && nameNode.nextSibling) {
                    targetContainer.insertBefore(newBadge, nameNode.nextSibling);
                } else {
                    targetContainer.appendChild(newBadge);
                }
            }
        } else if (existingBadge) {
            existingBadge.remove();
        }
    }

    // Scoped DOM injection with processing markers to optimize performance
    function injectReputationBadges() {
        if (isInjecting) return;
        isInjecting = true;

        try {
            if (window.location.href.includes('profiles.php')) {
                const currentProfileId = extractUserId(window.location.href);
                const profileHeader = document.querySelector(`
                    .user-information .title-container, 
                    .profile-header .name, 
                    .profile-container .user-name,
                    .profile-header-wrapper [class*="name"],
                    div[class*="user-information"] [class*="title"],
                    .basic-information .name
                `);
                if (currentProfileId && profileHeader) {
                    applyBadgeToElement(profileHeader, currentProfileId);
                }
            }

            const miniProfiles = document.querySelectorAll('#mini-profile-wrapper, [class*="miniProfileWrapper"], [class*="profile-container"], .mini-profile');
            miniProfiles.forEach(mini => {
                const profileLink = mini.querySelector('a[href*="profiles.php"], a[href*="XID="]');
                if (profileLink) {
                    const targetId = extractUserId(profileLink.getAttribute('href'));
                    const nameContainer = mini.querySelector('[class*="name"], .user-name, h4, .title') || profileLink;
                    if (targetId && nameContainer) applyBadgeToElement(nameContainer, targetId);
                }
            });

            const contentArea = document.querySelector('.content-wrapper') || document.body;
            const profileLinks = contentArea.querySelectorAll('a[href*="profiles.php?XID="], a[href*="step=profile"]');
            profileLinks.forEach(link => {
                if (link.classList.contains('trpt-processed')) return;
                link.classList.add('trpt-processed');

                if (link.closest('#sidebarroot, #chatRoot') || link.querySelector('.trpt-badge')) return;
                const targetId = extractUserId(link.getAttribute('href'));
                if (targetId && link.textContent.trim().length > 0) {
                    applyBadgeToElement(link, targetId);
                }
            });
        } finally {
            isInjecting = false;
        }
    }

    syncGlobalData(function() {
        ensureApiKey();
        fetchPast24HourRevives();
    });

    let debouncedTimer = null;
    const observer = new MutationObserver(() => {
        if (debouncedTimer) clearTimeout(debouncedTimer);
        debouncedTimer = setTimeout(injectReputationBadges, 300);
    });

    observer.observe(document.body, { childList: true, subtree: true });

    setInterval(syncGlobalData, 30000);
    setInterval(fetchPast24HourRevives, 60000);

})();
