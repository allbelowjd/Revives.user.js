// ==UserScript==
// @name         Torn Revive Payment Tracker (Faction Shared)
// @namespace    https://torn.com/
// @version      3.4.4
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching.
// @author       You
// @match        https://www.torn.com/*
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @connect      api.torn.com
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function () {
    'use strict';

    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj-HsObFkWJZ1ch2Ydd5SR/exec";
    const STORAGE_KEY_APIKEY = 'trpt_api_key';
    let sharedRevivesCache = [];
    let isFetchingRevives = false;

    // --- API KEY MANAGEMENT ---
    function getApiKey() {
        return GM_getValue(STORAGE_KEY_APIKEY, '');
    }

    function promptForApiKey() {
        const currentKey = getApiKey();
        const newKey = prompt('[TRPT] Enter your Torn API Key:', currentKey);
        if (newKey !== null) {
            GM_setValue(STORAGE_KEY_APIKEY, newKey.trim());
            alert('[TRPT] API Key updated!');
            fetchPast24HourRevives();
        }
    }

    if (typeof GM_registerMenuCommand !== 'undefined') {
        GM_registerMenuCommand("Set/Update Torn API Key", promptForApiKey);
    }

    function ensureApiKey() {
        let apiKey = getApiKey();
        if (!apiKey) promptForApiKey();
        return getApiKey();
    }

    function extractUserId(urlStr) {
        if (!urlStr) return null;
        const match = urlStr.match(/(?:XID|userID|NID|ID|step=profile&user=|user=|=)(\d+)/i);
        return match ? String(match[1]).trim() : null;
    }

    function isRevivePaid(revive) {
        if (!revive) return false;
        const val = revive.paid !== undefined ? revive.paid : revive.Paid;
        if (typeof val === 'boolean') return val;
        if (typeof val === 'number') return val === 1;
        if (typeof val === 'string') {
            const p = val.toUpperCase().trim();
            return p === 'TRUE' || p === '1' || p.includes('PAID');
        }
        return false;
    }

    // --- SYNC FROM GOOGLE SHEETS ---
    function syncGlobalData(callback) {
        if (!GOOGLE_SCRIPT_URL) return;

        GM_xmlhttpRequest({
            method: 'GET',
            url: GOOGLE_SCRIPT_URL,
            anonymous: true,
            onload: function (response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (Array.isArray(data)) {
                        sharedRevivesCache = data;
                        console.log('[TRPT] Cache updated:', sharedRevivesCache.length, 'records');
                        injectReputationBadges();
                        if (typeof callback === 'function') callback();
                    }
                } catch (e) {
                    console.error('[TRPT] Google Sheet Sync Failed. Verify Web App Deployment is set to "Anyone":', e);
                }
            }
        });
    }

    // --- LOG TO GOOGLE SHEETS ---
    window.logReviveToSheet = function(reviveData) {
        if (!GOOGLE_SCRIPT_URL) return;
        console.log('[TRPT] Sending payload to Sheet:', reviveData);

        GM_xmlhttpRequest({
            method: 'POST',
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/json" },
            data: JSON.stringify(reviveData),
            onload: function(response) {
                console.log('[TRPT] Logged response:', response.responseText);
                syncGlobalData();
            },
            onerror: function(err) {
                console.error('[TRPT] POST Request failed:', err);
            }
        });
    };

    // --- FETCH REVIVES FROM API ---
    function fetchPast24HourRevives() {
        if (isFetchingRevives) return;
        const apiKey = ensureApiKey();
        if (!apiKey) return;

        isFetchingRevives = true;
        const twentyFourHoursAgo = Math.floor((Date.now() - (24 * 60 * 60 * 1000)) / 1000);
        const apiUrl = `https://api.torn.com/faction/?selections=revives&from=${twentyFourHoursAgo}&key=${apiKey}`;

        GM_xmlhttpRequest({
            method: 'GET',
            url: apiUrl,
            onload: function(response) {
                isFetchingRevives = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data.error) {
                        console.error('[TRPT] Torn API Error Code:', data.error.code, data.error.error);
                        return;
                    }

                    if (!data.revives || Object.keys(data.revives).length === 0) {
                        console.warn('[TRPT] No revives returned from Torn API in past 24h.');
                        return;
                    }

                    Object.keys(data.revives).forEach(reviveId => {
                        const r = data.revives[reviveId];
                        const existing = sharedRevivesCache.find(
                            cached => String(cached.reviveId || cached.revive_id || '').trim() === String(reviveId).trim()
                        );

                        if (!existing) {
                            window.logReviveToSheet({
                                timestamp: new Date(r.timestamp * 1000).toISOString(),
                                reviveId: String(reviveId),
                                reviverName: r.reviver_name || 'Unknown',
                                targetId: String(r.target_id || r.target_userID || ''),
                                targetName: r.target_name || 'Unknown',
                                paid: Boolean(r.paid)
                            });
                        }
                    });
                } catch (e) {
                    console.error('[TRPT] Revive Parse Error:', e);
                }
            },
            onerror: function() { isFetchingRevives = false; }
        });
    }

    // --- DIRECT DOM REVIVE CATCHER (ON-SCREEN SUCCESS DETECTOR) ---
    function scanHospitalDOMForReviveSuccess() {
        const successMsg = document.querySelector('.msg.success, [class*="success"]');
        if (successMsg && successMsg.textContent.includes('revived')) {
            const profileLink = successMsg.querySelector('a[href*="profiles.php"]');
            if (profileLink) {
                const targetId = extractUserId(profileLink.getAttribute('href'));
                const targetName = profileLink.textContent.trim();
                const tempReviveId = 'local_' + Date.now();

                const existing = sharedRevivesCache.find(r => String(r.targetId).trim() === String(targetId).trim());
                if (!existing) {
                    console.log('[TRPT] Captured direct on-screen revive for ID:', targetId);
                    window.logReviveToSheet({
                        timestamp: new Date().toISOString(),
                        reviveId: tempReviveId,
                        reviverName: 'You',
                        targetId: targetId,
                        targetName: targetName,
                        paid: false
                    });
                }
            }
        }
    }

    // --- MANUAL TOGGLE ---
    window.togglePaymentStatus = function(targetId) {
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === String(targetId).trim());
        if (history.length === 0) return;

        const latest = history[history.length - 1];
        const newPaidStatus = !isRevivePaid(latest);

        window.logReviveToSheet({
            timestamp: latest.timestamp || new Date().toISOString(),
            reviveId: String(latest.reviveId || latest.revive_id),
            reviverName: latest.reviverName || 'Unknown',
            targetId: String(latest.targetId),
            targetName: latest.targetName || 'Unknown',
            paid: newPaidStatus
        });
    };

    // --- BADGE RENDER ENGINE ---
    function createBadgeElement(isPaid, targetId) {
        const badge = document.createElement('span');
        badge.className = 'trpt-badge';
        badge.style.cssText = `
            font-size: 11px;
            padding: 2px 6px;
            margin-left: 6px;
            border-radius: 3px;
            font-weight: bold;
            color: #ffffff;
            display: inline-block !important;
            vertical-align: middle;
            cursor: pointer;
            background-color: ${isPaid ? '#28a745' : '#dc3545'} !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.3);
            z-index: 99999;
        `;
        badge.textContent = isPaid ? 'PAID' : 'UNPAID';
        badge.title = 'Click to toggle payment status';

        badge.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (targetId) window.togglePaymentStatus(targetId);
        });

        return badge;
    }

    function applyBadgeToElement(targetContainer, targetId) {
        if (!targetContainer || !targetId) return;

        const normalizedTargetId = String(targetId).trim();
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === normalizedTargetId);
        const existingBadge = targetContainer.querySelector('.trpt-badge');

        if (history.length > 0) {
            const isPaid = history.some(r => isRevivePaid(r));
            const expectedText = isPaid ? 'PAID' : 'UNPAID';

            if (existingBadge) {
                if (existingBadge.textContent !== expectedText) {
                    existingBadge.textContent = expectedText;
                    existingBadge.style.backgroundColor = isPaid ? '#28a745' : '#dc3545';
                }
            } else {
                targetContainer.appendChild(createBadgeElement(isPaid, normalizedTargetId));
            }
        }
    }

    // --- TARGETED BADGE INJECTION ---
    function injectReputationBadges() {
        scanHospitalDOMForReviveSuccess();
        if (!Array.isArray(sharedRevivesCache) || sharedRevivesCache.length === 0) return;

        // Mini Profile Box targeting
        const miniProfiles = document.querySelectorAll('#mini-profile-wrapper, [class*="miniProfileWrapper"], [class*="profile-container"], [class*="user-profile"], .mini-profile');
        miniProfiles.forEach(mini => {
            const profileLink = mini.querySelector('a[href*="profiles.php"], a[href*="XID="]');
            if (profileLink) {
                const targetId = extractUserId(profileLink.getAttribute('href'));
                const nameContainer = mini.querySelector('[class*="name"], .user-name, h4, .title') || profileLink;
                if (targetId && nameContainer) applyBadgeToElement(nameContainer, targetId);
            }
        });

        // Hospital Table Rows targeting
        const profileLinks = document.querySelectorAll('a[href*="profiles.php"], a[href*="XID="]');
        profileLinks.forEach(link => {
            if (link.closest('#sidebarroot, #chatRoot, .user-menu') || link.textContent.trim() === '') return;
            const targetId = extractUserId(link.getAttribute('href'));
            if (targetId) applyBadgeToElement(link, targetId);
        });
    }

    // --- INIT ---
    syncGlobalData(function() {
        ensureApiKey();
        fetchPast24HourRevives();
    });

    const observer = new MutationObserver(() => injectReputationBadges());
    observer.observe(document.body, { childList: true, subtree: true });

    setInterval(syncGlobalData, 15000);
    setInterval(fetchPast24HourRevives, 30000);

})();
