// ==UserScript==
// @name         Torn Revive Payment Tracker (Faction Shared)
// @namespace    https://torn.com/
// @version      3.7.0
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching.
// @author       You
// @match        https://www.torn.com/*
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @connect      api.torn.com
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function () {
    'use strict';

    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj-HsObFkWJZ1ch2Ydd5SR/exec";
    const STORAGE_KEY_APIKEY = 'trpt_api_keys';
    let sharedRevivesCache = [];
    let isFetchingRevives = false;

    const badgeCSS = `
        .trpt-badge {
            font-size: 11px !important;
            padding: 2px 6px !important;
            margin-left: 6px !important;
            margin-right: 6px !important;
            border-radius: 3px !important;
            font-weight: bold !important;
            color: #ffffff !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.3) !important;
            z-index: 99999 !important;
            white-space: nowrap !important;
            height: 18px !important;
        }
        .trpt-badge.paid { background-color: #28a745 !important; }
        .trpt-badge.unpaid { background-color: #dc3545 !important; }
        .trpt-badge.untracked { background-color: #6c757d !important; }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(badgeCSS);
    } else {
        const style = document.createElement("style");
        style.textContent = badgeCSS;
        document.head.appendChild(style);
    }

    function getApiKey() {
        const raw = GM_getValue(STORAGE_KEY_APIKEY, '');
        if (!raw) return '';
        const keys = raw.split(',').map(k => k.trim()).filter(Boolean);
        if (keys.length === 0) return '';
        return keys[Math.floor(Math.random() * keys.length)];
    }

    function extractUserId(urlStr) {
        if (!urlStr) return null;
        const match = urlStr.match(/(?:XID|userID|NID|ID|step=profile&user=|user=|=)(\d+)/i);
        return match ? String(match[1]).trim() : null;
    }

    function isRevivePaid(revive) {
        if (!revive) return false;
        const val = revive.paid !== undefined ? revive.paid : revive.Paid;
        if (typeof val === 'boolean') return val;
        if (typeof val === 'number') return val === 1;
        if (typeof val === 'string') {
            const p = val.toUpperCase().trim();
            return p === 'TRUE' || p === '1' || p.includes('PAID');
        }
        return false;
    }

    function togglePaymentStatus(targetId) {
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === String(targetId).trim());
        let latest = history[history.length - 1];
        let newPaidStatus = latest ? !isRevivePaid(latest) : true;

        if (latest) {
            latest.paid = newPaidStatus;
            injectReputationBadges();
        }

        if (!GOOGLE_SCRIPT_URL) return;
        GM_xmlhttpRequest({
            method: 'POST',
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/json" },
            data: JSON.stringify({
                timestamp: latest?.timestamp || new Date().toISOString(),
                reviveId: String(latest?.reviveId || `manual_${Date.now()}`),
                reviverName: latest?.reviverName || 'You',
                targetId: String(targetId),
                targetName: latest?.targetName || 'Manual Entry',
                paid: newPaidStatus
            })
        });
    }

    function createBadgeElement(targetId) {
        const normalizedTargetId = String(targetId).trim();
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === normalizedTargetId);
        
        let statusClass = 'untracked';
        let statusText = 'UNTRACKED';
        
        if (history.length > 0) {
            const isPaid = history.some(r => isRevivePaid(r));
            statusClass = isPaid ? 'paid' : 'unpaid';
            statusText = isPaid ? 'PAID' : 'UNPAID';
        }

        const badge = document.createElement('span');
        badge.className = `trpt-badge ${statusClass}`;
        badge.dataset.trptTarget = normalizedTargetId; 
        badge.textContent = statusText;
        badge.title = 'Click to toggle status';

        badge.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            togglePaymentStatus(normalizedTargetId);
        });

        return badge;
    }

    function injectReputationBadges() {
        const links = document.querySelectorAll('a[href*="profiles.php"], a[href*="XID="], a[href*="step=profile"]');
        
        links.forEach(link => {
            if (link.closest('#sidebarroot, #chatRoot') || link.querySelector('.trpt-badge')) return;
            
            const targetId = extractUserId(link.getAttribute('href'));
            if (!targetId || link.textContent.trim().length === 0) return;

            const normalizedTargetId = String(targetId).trim();
            const existingBadge = link.parentNode.querySelector(`.trpt-badge[data-trpt-target="${normalizedTargetId}"]`);

            if (!existingBadge) {
                const newBadge = createBadgeElement(normalizedTargetId);
                link.insertAdjacentElement('afterend', newBadge);
            }
        });
    }

    setInterval(injectReputationBadges, 1000);

    const localCache = GM_getValue('trpt_shared_cache');
    if (localCache) sharedRevivesCache = JSON.parse(localCache);

})();
