// ==UserScript==
// @name         Torn Revive Payment Tracker (Faction Shared)
// @namespace    https://torn.com/
// @version      3.8.0
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching.
// @author       You
// @match        https://www.torn.com/*
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @connect      api.torn.com
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function () {
    'use strict';

    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj-HsObFkWJZ1ch2Ydd5SR/exec";
    const STORAGE_KEY_APIKEY = 'trpt_api_keys';
    let sharedRevivesCache = [];
    let isFetchingRevives = false;

    const badgeCSS = `
        .trpt-badge {
            font-size: 11px !important;
            padding: 2px 6px !important;
            margin-left: 6px !important;
            margin-right: 6px !important;
            border-radius: 3px !important;
            font-weight: bold !important;
            color: #ffffff !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.3) !important;
            z-index: 99999 !important;
            white-space: nowrap !important;
            height: 18px !important;
        }
        .trpt-badge.paid { background-color: #28a745 !important; }
        .trpt-badge.unpaid { background-color: #dc3545 !important; }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(badgeCSS);
    } else {
        const style = document.createElement("style");
        style.textContent = badgeCSS;
        document.head.appendChild(style);
    }

    function getApiKey() {
        const raw = GM_getValue(STORAGE_KEY_APIKEY, '');
        if (!raw) return '';
        const keys = raw.split(',').map(k => k.trim()).filter(Boolean);
        if (keys.length === 0) return '';
        return keys[Math.floor(Math.random() * keys.length)];
    }

    function promptForApiKey() {
        const currentKeys = GM_getValue(STORAGE_KEY_APIKEY, '');
        const newKeys = prompt('[TRPT] Enter Torn API Key(s), separated by commas if using multiple:', currentKeys);
        if (newKeys !== null) {
            GM_setValue(STORAGE_KEY_APIKEY, newKeys.trim());
            alert('[TRPT] API Key(s) updated!');
            fetchPast24HourRevives();
        }
    }

    if (typeof GM_registerMenuCommand !== 'undefined') {
        GM_registerMenuCommand("Set/Update Torn API Key(s)", promptForApiKey);
    }

    function ensureApiKey() {
        let apiKey = getApiKey();
        if (!apiKey) promptForApiKey();
        return getApiKey();
    }

    function extractUserId(urlStr) {
        if (!urlStr) return null;
        const match = urlStr.match(/(?:XID|userID|NID|ID|step=profile&user=|user=|=)(\d+)/i);
        return match ? String(match[1]).trim() : null;
    }

    function isRevivePaid(revive) {
        if (!revive) return false;
        const val = revive.paid !== undefined ? revive.paid : revive.Paid;
        if (typeof val === 'boolean') return val;
        if (typeof val === 'number') return val === 1;
        if (typeof val === 'string') {
            const p = val.toUpperCase().trim();
            return p === 'TRUE' || p === '1' || p.includes('PAID');
        }
        return false;
    }

    function syncGlobalData(callback) {
        if (!GOOGLE_SCRIPT_URL) return;

        GM_xmlhttpRequest({
            method: 'GET',
            url: GOOGLE_SCRIPT_URL,
            anonymous: true,
            onload: function (response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (Array.isArray(data)) {
                        sharedRevivesCache = data;
                        GM_setValue('trpt_shared_cache', JSON.stringify(data));
                        if (typeof callback === 'function') callback();
                    }
                } catch (e) {
                    console.error('[TRPT] Sync Error:', e);
                }
            }
        });
    }

    function logReviveToSheet(reviveData) {
        if (!GOOGLE_SCRIPT_URL) return;
        GM_xmlhttpRequest({
            method: 'POST',
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/json" },
            data: JSON.stringify(reviveData),
            onload: function() {
                setTimeout(syncGlobalData, 1000);
            }
        });
    }

    function fetchPast24HourRevives() {
        if (isFetchingRevives) return;
        const apiKey = getApiKey();
        if (!apiKey) return;

        isFetchingRevives = true;
        const twentyFourHoursAgo = Math.floor((Date.now() - (24 * 60 * 60 * 1000)) / 1000);
        const apiUrl = `https://api.torn.com/faction/?selections=revives&from=${twentyFourHoursAgo}&key=${apiKey}`;

        GM_xmlhttpRequest({
            method: 'GET',
            url: apiUrl,
            onload: function(response) {
                isFetchingRevives = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data.error || !data.revives) return;

                    Object.keys(data.revives).forEach(reviveId => {
                        const r = data.revives[reviveId];
                        const existing = sharedRevivesCache.find(
                            cached => String(cached.reviveId || cached.revive_id || '').trim() === String(reviveId).trim()
                        );

                        if (!existing) {
                            logReviveToSheet({
                                timestamp: new Date((r.timestamp || Math.floor(Date.now() / 1000)) * 1000).toISOString(),
                                reviveId: String(reviveId),
                                reviverName: r.reviver_name || r.reviver_username || 'Unknown',
                                targetId: String(r.target_id || r.target_userID || r.target_user_id || ''),
                                targetName: r.target_name || r.target_username || 'Unknown',
                                paid: isRevivePaid(r)
                            });
                        }
                    });
                } catch (e) {}
            },
            onerror: function() { isFetchingRevives = false; }
        });
    }

    function togglePaymentStatus(targetId) {
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === String(targetId).trim());
        let latest = history[history.length - 1];
        let newPaidStatus = latest ? !isRevivePaid(latest) : true;

        if (latest) {
            latest.paid = newPaidStatus;
            injectReputationBadges();
        }

        logReviveToSheet({
            timestamp: latest?.timestamp || new Date().toISOString(),
            reviveId: String(latest?.reviveId || `manual_${Date.now()}`),
            reviverName: latest?.reviverName || 'You',
            targetId: String(targetId),
            targetName: latest?.targetName || 'Manual Entry',
            paid: newPaidStatus
        });
    }

    function createBadgeElement(targetId) {
        const normalizedTargetId = String(targetId).trim();
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === normalizedTargetId);
        
        let isPaid = false;
        if (history.length > 0) {
            isPaid = history.some(r => isRevivePaid(r));
        }
        
        const statusClass = isPaid ? 'paid' : 'unpaid';
        const statusText = isPaid ? 'PAID' : 'UNPAID';

        const badge = document.createElement('span');
        badge.className = `trpt-badge ${statusClass}`;
        badge.dataset.trptTarget = normalizedTargetId; 
        badge.textContent = statusText;
        badge.title = 'Click to toggle status';

        badge.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            togglePaymentStatus(normalizedTargetId);
        });

        return badge;
    }

    function applyBadgeToElement(targetElement, targetId) {
        if (!targetElement || !targetElement.parentNode || !targetId) return;

        const normalizedTargetId = String(targetId).trim();
        let existingBadge = targetElement.parentNode.querySelector(`.trpt-badge[data-trpt-target="${normalizedTargetId}"]`);
        
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === normalizedTargetId);
        let isPaid = false;
        if (history.length > 0) {
            isPaid = history.some(r => isRevivePaid(r));
        }

        const statusClass = isPaid ? 'trpt-badge paid' : 'trpt-badge unpaid';
        const statusText = isPaid ? 'PAID' : 'UNPAID';

        if (existingBadge) {
            existingBadge.className = `trpt-badge ${statusClass}`;
            existingBadge.textContent = statusText;
        } else {
            const newBadge = createBadgeElement(normalizedTargetId);
            targetElement.insertAdjacentElement('afterend', newBadge);
        }
    }

    function injectReputationBadges() {
        const links = document.querySelectorAll('a[href*="profiles.php"], a[href*="XID="], a[href*="step=profile"]');
        
        links.forEach(link => {
            if (link.closest('#sidebarroot, #chatRoot')) return;
            
            const targetId = extractUserId(link.getAttribute('href'));
            if (!targetId || link.textContent.trim().length === 0) return;

            applyBadgeToElement(link, targetId);
        });
    }

    // Load local cache immediately for instant display
    const localCache = GM_getValue('trpt_shared_cache');
    if (localCache) {
        try { sharedRevivesCache = JSON.parse(localCache); } catch(e) {}
    }

    syncGlobalData(function() {
        ensureApiKey();
        fetchPast24HourRevives();
    });

    setInterval(injectReputationBadges, 1000);
    setInterval(syncGlobalData, 30000);
    setInterval(fetchPast24HourRevives, 60000);

})();
