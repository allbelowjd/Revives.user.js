// ==UserScript==
// @name         Torn Revive Payment Tracker (Faction Shared)
// @namespace    https://torn.com/
// @version      3.4.2
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching.
// @author       You
// @match        https://www.torn.com/*
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives.user.js/main/Revives
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @connect      api.torn.com
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function () {
    'use strict';

    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj-HsObFkWJZ1ch2Ydd5SR/exec";
    const STORAGE_KEY_APIKEY = 'trpt_api_key';
    let sharedRevivesCache = [];
    let isFetchingRevives = false;

    // --- API KEY MANAGEMENT ---
    function getApiKey() {
        return GM_getValue(STORAGE_KEY_APIKEY, '');
    }

    function promptForApiKey() {
        const currentKey = getApiKey();
        const newKey = prompt('[TRPT] Enter your Torn API Key (Limited or Full access required):', currentKey);
        if (newKey !== null) {
            GM_setValue(STORAGE_KEY_APIKEY, newKey.trim());
            alert('[TRPT] API Key updated successfully!');
            fetchPast24HourRevives();
            checkIncomingPayments();
        }
    }

    if (typeof GM_registerMenuCommand !== 'undefined') {
        GM_registerMenuCommand("Set/Update Torn API Key", promptForApiKey);
    }

    function ensureApiKey() {
        let apiKey = getApiKey();
        if (!apiKey) {
            promptForApiKey();
        }
        return getApiKey();
    }

    function extractUserId(urlStr) {
        if (!urlStr) return null;
        const match = urlStr.match(/(?:XID|userID|NID|ID|step=profile&user=|=)(\d+)/i);
        return match ? String(match[1]).trim() : null;
    }

    function isRevivePaid(revive) {
        if (!revive) return false;
        const val = revive.paid !== undefined ? revive.paid : revive.Paid;
        if (typeof val === 'boolean') return val;
        if (typeof val === 'number') return val === 1;
        if (typeof val === 'string') {
            const p = val.toUpperCase().trim();
            return p === 'TRUE' || p === '1' || p.includes('PAID');
        }
        return false;
    }

    // --- HARDENED FETCH DATA FROM GOOGLE SHEETS ---
    function syncGlobalData(callback) {
        if (!GOOGLE_SCRIPT_URL) return;

        GM_xmlhttpRequest({
            method: 'GET',
            url: GOOGLE_SCRIPT_URL,
            anonymous: true,
            followRedirects: true,
            onload: function (response) {
                if (response.responseText.trim().startsWith('<')) {
                    console.warn('[TRPT] Received HTML response instead of JSON. Verify Google Script access is set to "Anyone".');
                    return;
                }

                try {
                    const data = JSON.parse(response.responseText);
                    if (Array.isArray(data)) {
                        sharedRevivesCache = data;
                        injectReputationBadges();
                        if (typeof callback === 'function') callback();
                    }
                } catch (e) {
                    console.error('[TRPT] Sync Parse Error (Skipped bad response):', e);
                }
            },
            onerror: function(err) {
                console.error('[TRPT] Network Request Failed:', err);
            }
        });
    }

    // --- LOG OR UPDATE REVIVE TO GOOGLE SHEETS ---
    window.logReviveToSheet = function(reviveData) {
        if (!GOOGLE_SCRIPT_URL) return;

        GM_xmlhttpRequest({
            method: 'POST',
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/json" },
            data: JSON.stringify(reviveData),
            onload: function(response) {
                console.log('[TRPT] Logged/Updated successfully:', response.responseText);
                syncGlobalData();
            }
        });
    };

    // --- FAST FETCH 24H REVIVES FROM TORN API ---
    function fetchPast24HourRevives() {
        if (isFetchingRevives) return;
        const apiKey = ensureApiKey();
        if (!apiKey) return;

        isFetchingRevives = true;
        const twentyFourHoursAgo = Math.floor((Date.now() - (24 * 60 * 60 * 1000)) / 1000);
        const apiUrl = `https://api.torn.com/faction/?selections=revives&from=${twentyFourHoursAgo}&key=${apiKey}`;

        GM_xmlhttpRequest({
            method: 'GET',
            url: apiUrl,
            onload: function(response) {
                isFetchingRevives = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data.error || !data.revives) return;

                    Object.keys(data.revives).forEach(reviveId => {
                        const r = data.revives[reviveId];
                        if (r.timestamp < twentyFourHoursAgo) return;

                        const existing = sharedRevivesCache.find(
                            cached => String(cached.reviveId || cached.revive_id || '').trim() === String(reviveId).trim()
                        );

                        if (!existing) {
                            window.logReviveToSheet({
                                timestamp: new Date(r.timestamp * 1000).toISOString(),
                                reviveId: String(reviveId),
                                reviverName: r.reviver_name || 'Unknown',
                                targetId: String(r.target_id),
                                targetName: r.target_name || 'Unknown',
                                paid: Boolean(r.paid)
                            });
                        }
                    });
                } catch (e) {
                    console.error('[TRPT] 24h Revive Fetch Error:', e);
                }
            },
            onerror: function() {
                isFetchingRevives = false;
            }
        });
    }

    // --- AUTOMATED INCOMING PAYMENT SCANNER ---
    function checkIncomingPayments() {
        const apiKey = ensureApiKey();
        if (!apiKey) return;

        const apiUrl = `https://api.torn.com/user/?selections=events&key=${apiKey}`;

        GM_xmlhttpRequest({
            method: 'GET',
            url: apiUrl,
            onload: function(response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (data.error || !data.events) return;

                    Object.keys(data.events).forEach(eventId => {
                        const event = data.events[eventId];
                        const eventText = event.event || '';

                        if (eventText.includes('received') || eventText.includes('sent you') || eventText.includes('money')) {
                            const senderIdMatch = eventText.match(/XID=(\d+)/i) || eventText.match(/profiles\.php\?XID=(\d+)/i);
                            if (!senderIdMatch) return;

                            const senderId = String(senderIdMatch[1]).trim();

                            const unpaidRevive = sharedRevivesCache.find(r => {
                                const tid = String(r.targetId || r.target_id || '').trim();
                                return tid === senderId && !isRevivePaid(r);
                            });

                            if (unpaidRevive) {
                                console.log(`[TRPT Auto-Pay] Payment detected from ID ${senderId}. Marking PAID.`);
                                window.logReviveToSheet({
                                    reviveId: String(unpaidRevive.reviveId || unpaidRevive.revive_id),
                                    targetId: senderId,
                                    paid: true
                                });
                            }
                        }
                    });
                } catch (e) {
                    console.error('[TRPT Auto-Pay] Error:', e);
                }
            }
        });
    }

    // --- MANUAL TOGGLE FALLBACK ---
    window.togglePaymentStatus = function(targetId) {
        const history = sharedRevivesCache.filter(r => String(r.targetId || r.target_id || '').trim() === String(targetId).trim());
        if (history.length === 0) return;

        const latest = history[history.length - 1];
        const newPaidStatus = !isRevivePaid(latest);

        window.logReviveToSheet({
            timestamp: latest.timestamp || new Date().toISOString(),
            reviveId: String(latest.reviveId),
            reviverName: latest.reviverName || 'Unknown',
            targetId: String(latest.targetId),
            targetName: latest.targetName || 'Unknown',
            paid: newPaidStatus
        });
    };

    // --- BADGE RENDER ENGINE ---
    function createBadgeElement(isPaid, targetId) {
        const badge = document.createElement('span');
        badge.className = 'trpt-badge';
        badge.style.cssText = `
            font-size: 11px;
            padding: 2px 6px;
            margin-left: 6px;
            border-radius: 3px;
            font-weight: bold;
            color: #ffffff;
            display: inline-block !important;
            vertical-align: middle;
            cursor: pointer;
            background-color: ${isPaid ? '#28a745' : '#dc3545'} !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.3);
            z-index: 99999;
        `;
        badge.textContent = isPaid ? 'PAID' : 'UNPAID';
        badge.title = 'Click to manually toggle status';

        badge.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (targetId) window.togglePaymentStatus(targetId);
        });

        return badge;
    }

    function applyBadgeToElement(targetContainer, targetId) {
        if (!targetContainer || !targetId) return;

        const normalizedTargetId = String(targetId).trim();

        const history = sharedRevivesCache.filter(r => {
            const rowTargetId = String(r.targetId || r.target_id || '').trim();
            return rowTargetId === normalizedTargetId;
        });

        const existingBadge = targetContainer.querySelector('.trpt-badge');

        if (history.length > 0) {
            const isPaid = history.some(r => isRevivePaid(r));
            const expectedText = isPaid ? 'PAID' : 'UNPAID';

            if (existingBadge) {
                if (existingBadge.textContent !== expectedText) {
                    existingBadge.textContent = expectedText;
                    existingBadge.style.backgroundColor = isPaid ? '#28a745' : '#dc3545';
                }
            } else {
                targetContainer.appendChild(createBadgeElement(isPaid, normalizedTargetId));
            }
        } else if (existingBadge) {
            existingBadge.remove();
        }
    }

    // --- REFINED BADGE INJECTION LOGIC ---
    function injectReputationBadges() {
        if (!Array.isArray(sharedRevivesCache) || sharedRevivesCache.length === 0) return;

        // 1. Full Profile Page Main Header
        if (window.location.href.includes('profiles.php')) {
            const currentId = extractUserId(window.location.href);
            if (currentId) {
                const mainHeader = document.querySelector('.profile-wrapper .title-container, .user-information .heading, h2.title');
                if (mainHeader) {
                    applyBadgeToElement(mainHeader, currentId);
                }
            }
        }

        // 2. Desktop Mini Profile Popups
        const miniProfiles = document.querySelectorAll('#mini-profile-wrapper, [class*="miniProfileContainer"], [class*="miniProfileWrapper"]');
        miniProfiles.forEach(mini => {
            const profileLink = mini.querySelector('a[href*="profiles.php"]');
            if (profileLink) {
                const targetId = extractUserId(profileLink.getAttribute('href'));
                const nameContainer = mini.querySelector('.name, [class*="name"], .user-name, h4') || profileLink;
                if (targetId && nameContainer) {
                    applyBadgeToElement(nameContainer, targetId);
                }
            }
        });

        // 3. Header Search Bar Dropdown Results
        const searchItems = document.querySelectorAll('#search-autocomplete-list li, [class*="searchResult"] li, .search-results-wrapper a[href*="profiles.php"], ul[class*="results"] a[href*="profiles.php"]');
        searchItems.forEach(item => {
            const link = item.tagName === 'A' ? item : item.querySelector('a[href*="profiles.php"]');
            if (link) {
                const targetId = extractUserId(link.getAttribute('href'));
                const textWrapper = link.querySelector('.name, [class*="name"], span') || link;
                if (targetId && textWrapper) {
                    applyBadgeToElement(textWrapper, targetId);
                }
            }
        });

        // 4. Standard Text Links Across Main Content Tables & Lists
        const profileLinks = document.querySelectorAll('a[href*="profiles.php?XID="], a[href*="XID="]');

        profileLinks.forEach(link => {
            if (
                link.closest('#sidebarroot, #chatRoot, .user-menu, .action-images, .medals-container') ||
                link.querySelector('img, svg, canvas, i, span.icon') ||
                link.textContent.trim() === ''
            ) {
                return;
            }

            const targetId = extractUserId(link.getAttribute('href'));
            if (targetId) {
                applyBadgeToElement(link, targetId);
            }
        });
    }

    // --- INITIALIZATION & OBSERVERS ---
    syncGlobalData(function() {
        ensureApiKey();
        fetchPast24HourRevives();
        checkIncomingPayments();
    });

    const observer = new MutationObserver(() => {
        injectReputationBadges();
    });
    observer.observe(document.body, { childList: true, subtree: true });

    // Polling schedules
    setInterval(syncGlobalData, 15000);          // 15s Sheet cache sync
    setInterval(fetchPast24HourRevives, 60000);   // 60s Revive API fetch
    setInterval(checkIncomingPayments, 60000);    // 60s Event payment check

})();
